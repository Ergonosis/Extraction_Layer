# Copy to .env for local API (never commit real secrets).

FLASK_ENV=development
EXTRACTION_PORTAL_FLASK_SECRET_KEY=dev-only-change-me
EXTRACTION_PORTAL_DATABASE_URL=postgresql://portal:portal@localhost:5434/portal

# Shared sessions + rate limits on PostgreSQL by default (issue #56).
SESSION_BACKEND=sqlalchemy
RATELIMIT_STORAGE_BACKEND=sqlalchemy
# Optional Redis fallback (set SESSION_BACKEND=redis and/or RATELIMIT_STORAGE_BACKEND=redis):
# REDIS_URL=redis://localhost:6379/0
# Production Firebase Hosting forwards only __session:
# SESSION_COOKIE_NAME=__session

# Microsoft SSO — use the dedicated Portal Entra app (multi-tenant), NOT the shared
# Ergonosis_data_getter job registration. Authority is /organizations.
# Do not rely on MSGRAPH_TENANT_ID for Portal SSO.
# MSGRAPH_CLIENT_ID=
# MSGRAPH_CLIENT_SECRET=
# MS_REDIRECT_URI=http://localhost:5175/api/auth/callback
# Optional: comma-separated Entra tenant IDs allowed to sign in (empty = any org tenant)
# MS_TENANT_ALLOWLIST=
# Graph delegated connect — register this redirect URI on the Portal Entra app
# MS_GRAPH_REDIRECT_URI=http://localhost:5175/api/msgraph/callback
# Optional legacy single-tenant id for standalone microsoft/ scripts only — not portal SSO
# MSGRAPH_TENANT_ID=

# LOCAL ONLY — never set true in production (app refuses to boot if you do)
ENABLE_DEV_LOGIN=true

# Platform admins (Ergonosis staff) for Admin Billing — comma-separated.
# Bootstrap before/while platform_admins table is seeded. Match SSO email and/or Entra oid.
# PLATFORM_ADMIN_EMAILS=you@ergonosis.com
# PLATFORM_ADMIN_MS_OIDS=

# Shared secret for Cloud Scheduler → POST /api/billing/jobs/dunning
# and POST /api/billing/jobs/meter-retry
# BILLING_JOB_SECRET=
# BILLING_PAST_DUE_GRACE_DAYS=5

# Stripe Billing (issue #64). Default OFF = mock adapter (no Stripe account needed).
# Turn on for sandbox/live: STRIPE_ENABLED=true + Dashboard test or live keys.
# STRIPE_ENABLED=false
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional: Billing Meter event names (must match Stripe Meter event_name)
# STRIPE_METER_EVENT_EXPORTS=exports
# STRIPE_METER_EVENT_API_CALLS=api_calls
# Optional: recurring test price for scripts/billing_stripe_sandbox_e2e.py
# STRIPE_SANDBOX_PRICE_ID=price_...

# Billing reminder emails (issue #64 hardening). Default OFF = log only.
# Also enable Stripe Dashboard → Billing emails for failed payment / expiring cards.
# BILLING_EMAIL_ENABLED=false
# BILLING_EMAIL_FROM=billing@yourdomain.com
# BILLING_SMTP_HOST=smtp.example.com
# BILLING_SMTP_PORT=587
# BILLING_SMTP_USER=
# BILLING_SMTP_PASSWORD=
# BILLING_SMTP_USE_TLS=true





# Content-Security-Policy for SPA (issue #33): off | report-only | enforce
# Empty = report-only in development, enforce in production
# CSP_MODE=report-only

# Fernet key for encrypting integration tokens (required for Plaid/MS Graph)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# EXTRACTION_PORTAL_FERNET_KEY=

# Plaid (sandbox for local Link flows)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
