# Copy to .env for local API (never commit real secrets).

FLASK_ENV=development
SECRET_KEY=dev-only-change-me
DATABASE_URL=postgresql://portal:portal@localhost:5434/portal
REDIS_URL=redis://localhost:6379/0

# Microsoft SSO (required for real Sign in with Microsoft)
# Authority is /organizations (any work/school tenant). Do not rely on MS_TENANT_ID for SSO.
# MS_CLIENT_ID=
# MS_CLIENT_SECRET=
# MS_REDIRECT_URI=http://localhost:5175/api/auth/callback
# Optional: comma-separated Entra tenant IDs allowed to sign in (empty = any org tenant)
# MS_TENANT_ALLOWLIST=
# Graph delegated connect (issue #25) — register this redirect URI in Entra
# MS_GRAPH_REDIRECT_URI=http://localhost:5175/api/msgraph/callback
# Optional legacy single-tenant id for standalone microsoft/ scripts only — not portal SSO
# MS_TENANT_ID=

# LOCAL ONLY — never set true in production (app refuses to boot if you do)
ENABLE_DEV_LOGIN=true

# Content-Security-Policy for SPA (issue #33): off | report-only | enforce
# Empty = report-only in development, enforce in production
# CSP_MODE=report-only

# Fernet key for encrypting integration tokens (required for Plaid/MS Graph)
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FERNET_KEY=

# Plaid (sandbox for local Link flows)
# PLAID_CLIENT_ID=
# PLAID_SECRET=
# PLAID_ENV=sandbox
