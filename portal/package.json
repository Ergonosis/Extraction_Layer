{
  "name": "portal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint:onlyerr": "bun lint --quiet",
    "lint:fix": "bun lint --fix --fix-suggestions",
    "lint:fix:danger": "bun run lint:fix --fix-dangerously",
    "preview": "vite preview",
    "preinstall": "npx only-allow bun",
    "prepare": "cd \"$(git rev-parse --show-toplevel)\" && npx --yes simple-git-hooks"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-plaid-link": "^5.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint-plugin-react-compiler": "^19.1.0-rc.2",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "^1.4.4",
      "onFail": "error"
    }
  },
  "engines": {
    "bun": "^1.4.4"
  }
}
