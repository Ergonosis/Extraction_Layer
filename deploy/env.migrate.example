# Cloud Run schema Job configuration. Copy to env.migrate.local and
# source it before running migrate-cloud-run-job.sh. Never commit real secrets.

GCP_PROJECT_ID=your-gcp-project
REGION=us-central1
JOB_NAME=extraction-portal-migrate
IMAGE=us-central1-docker.pkg.dev/your-gcp-project/portal/extraction-portal@sha256:REPLACE_WITH_DIGEST
CLOUD_SQL_INSTANCE=your-gcp-project:us-central1:portal-sql

# SERVICE_ACCOUNT=extraction-portal-run@your-gcp-project.iam.gserviceaccount.com
# VPC_CONNECTOR=projects/your-gcp-project/locations/us-central1/connectors/portal-connector

DATABASE_URL_SECRET=DATABASE_URL
SECRET_KEY_SECRET=SECRET_KEY
FERNET_KEY_SECRET=FERNET_KEY
