# Copy to a *local* env file (never commit) and `source` / set before deploy scripts.
# Example:  set -a; source deploy/env.deploy.local; set +a; bash deploy/deploy-cloud-run.sh

GCP_PROJECT_ID=your-gcp-project
REGION=us-central1
SERVICE_NAME=extraction-portal
AR_REPO=portal
IMAGE_NAME=extraction-portal

# Runtime identity (needs roles/secretmanager.secretAccessor + Cloud SQL client)
# SERVICE_ACCOUNT=extraction-portal-sa@your-gcp-project.iam.gserviceaccount.com

# Cloud SQL (built-in Auth Proxy socket — VPC connector not required for first launch)
# CLOUD_SQL_INSTANCE=your-gcp-project:us-central1:portal-sql

# Firebase Hosting origin (preferred) — same values for CORS + Entra redirects
PORTAL_URL=https://your-firebase-project.web.app
CORS_ORIGINS=https://your-firebase-project.web.app
MS_REDIRECT_URI=https://your-firebase-project.web.app/api/auth/callback
MS_GRAPH_REDIRECT_URI=https://your-firebase-project.web.app/api/msgraph/callback

MS_CLIENT_ID=your-entra-app-client-id
# Optional: comma-separated Entra tenant IDs
# MS_TENANT_ALLOWLIST=

# Prefer Cloud SQL Auth Proxy / unix socket URL — do not commit real passwords
DATABASE_URL=postgresql://portal:CHANGE_ME@/portal?host=/cloudsql/your-gcp-project:us-central1:portal-sql

# Shared state backends (issue #56). Default: PostgreSQL sessions + rate limits.
SESSION_BACKEND=sqlalchemy
RATELIMIT_STORAGE_BACKEND=sqlalchemy
# Only required when either backend is redis:
# REDIS_URL=redis://10.x.x.x:6379/0
# VPC_CONNECTOR=projects/your-gcp-project/locations/us-central1/connectors/portal-connector

# Connection pool caps (instances × workers × (pool_size + max_overflow) ≤ DB budget)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5

PLAID_ENV=sandbox
# PLAID_CLIENT_ID=

# Secret Manager secret *ids* (values live in GCP only)
SECRET_KEY_SECRET=SECRET_KEY
FERNET_KEY_SECRET=FERNET_KEY
MS_CLIENT_SECRET_SECRET=MS_CLIENT_SECRET
PLAID_SECRET_SECRET=PLAID_SECRET
